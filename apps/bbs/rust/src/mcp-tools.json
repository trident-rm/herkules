    },
    "outputSchema": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "annotations": {
      "readOnlyHint": true
    }
  }
]
