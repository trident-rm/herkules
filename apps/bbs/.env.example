# apps/bbs — copy to .env. Every variable is validated at boot (src/config.ts).
#
# Local walkthrough (proven 2026-08-28):
#   mkdir -p .data                                 PGlite does not create the parent directory
#   vp run import ../../../rm-wenku/data/app.db    the corpus, ~4 s
#   vp run dev          Hono on :3103        vp run dev:web      Vite SPA on :3003 (the app origin)
#   Login/MCP need the platform too: services/auth (`vp run dev`, :3001) with BBS_ORIGIN=http://localhost:3003
#   and the same BBS_CLIENT_SECRET in its .env, plus services/web (`vp dev`, :3000, proxies /auth and /mcp/bbs).
#   MCP locally: claude mcp add --transport http rm-wenku http://localhost:3000/mcp/bbs
#   What ships:  vp run build && WEB_DIR=$PWD/dist/client node --env-file=.env dist/main.mjs

# The PLATFORM origin: issuer = ${PUBLIC_ORIGIN}/auth, audiences ${PUBLIC_ORIGIN}/api/bbs and /mcp/bbs.
PUBLIC_ORIGIN=http://localhost:3000
# THIS app's origin (cookies, redirect URI ${APP_ORIGIN}/callback, og:url). Dev: the Vite server on :3003.
APP_ORIGIN=http://localhost:3003
# Where this process reaches services/auth (JWKS, token endpoint, user-info). Defaults to PUBLIC_ORIGIN.
#AUTH_INTERNAL_URL=http://auth:3001

# postgres://…/bbs in compose; pglite://memory or pglite:///abs/path locally (pg_trgm is loaded for you).
DATABASE_URL=pglite:///abs/path/to/apps/bbs/.data/bbs
# Same value services/auth seeds the confidential `bbs` client with.
BBS_CLIENT_SECRET=
# ≥ 32 chars; seals the session cookie. Rotating it signs every browser out.
BBS_COOKIE_SECRET=
# Built SPA directory (index.html + assets/). Unset in dev: the Vite dev server serves the SPA.
#WEB_DIR=/app/dist/client
# trgm (default, stock Postgres) | pgroonga (the check-5 fallback; needs the custom image)
SEARCH_INDEX=trgm
# Incremental Rust corpus reads (article, content, tags, AI). Requires shared Postgres.
# Leave unset for the existing PGlite/local stack. Rust listens on :3203 by default.
# BBS_RUST_READ_ORIGIN=http://127.0.0.1:3203
# false when the role may not CREATE DATABASE; then run `createdb bbs` once yourself.
BBS_CREATE_DATABASE=true

# drizzle migrations; the source tree's ./drizzle by default, /app/drizzle in the image.
#MIGRATIONS_DIR=/app/drizzle

# The Hono process. In dev the Vite server owns :3003 and proxies here.
PORT=3103
NODE_ENV=development

# Optional local bot process: copy these shared values plus the lines below to .env.bot, then run
# `vp run bot`. Production uses tools/deploy/.env.bot instead.
# DATABASE_URL=pglite:///abs/path/to/apps/bbs/.data/bbs
# APP_ORIGIN=http://localhost:3003
# SEARCH_INDEX=trgm
# FEISHU_APP_ID=cli_...
# FEISHU_APP_SECRET=
# FEISHU_ANNOUNCEMENT_CHAT_ID=oc_...
